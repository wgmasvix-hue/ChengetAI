{
  "appId": "zw.co.chengetailabs.dare",
  "appName": "Dare",
  "webDir": "www",
  "server": {
    "url": "https://repo.dare.co.zw",
    "cleartext": false,
    "errorPath": "offline.html",
    "allowNavigation": [
      "dare.co.zw",
      "*.dare.co.zw"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#0f5a34",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": true,
      "spinnerColor": "#ffffff",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "backgroundColor": "#0f5a34",
      "style": "DARK"
    }
  }
}
